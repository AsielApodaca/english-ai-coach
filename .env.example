# LLM provider selection. Options: cloudflare | gemini | ollama
# Default "cloudflare" works with your existing CLOUDFLARE_API_TOKEN (account id is
# auto-discovered from ~/.config/opencode).
LLM_PROVIDER=cloudflare

# Canned replies for practice/eval (no LLM calls). Enable per-run with a
# prefix — shell variables override .env, and npm start alone runs normal
# mode with real LLMs. The lookup popup always uses real providers:
#   MOCK_LLM=1 npm start
# MOCK_LLM=1

# Google Gemini free-tier API key (from https://aistudio.google.com/apikey)
# Leave empty to disable Gemini.
GEMINI_API_KEY=

# Cloudflare Workers AI (free tier). Token. Account id is auto-discovered from the
# opencode config; set explicitly only if different.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# Ollama local (optional, offline).
OLLAMA_MODEL=llama3.1

# Server port
PORT=3000

# Whisper local STT (optional). Model name downloaded under models/ (e.g. small.en)
WHISPER_MODEL=small.en

# Local Ollama tuning (fast model serves the lookup popup; the main model
# serves session/practice generation when MOCK_LLM is unset).
# OLLAMA_CTX=32768        # num_ctx for the session model (KV RAM cap)
# OLLAMA_FAST_MODEL=      # e.g. phi4-mini-32k:latest — fast popup model
# OLLAMA_FAST_CTX=8192    # num_ctx for the fast popup model
# OLLAMA_WARM=0           # set to 0 to disable the local-model warmup at server
                          # boot and app load (1-token request per Ollama model);
                          # it also disables the auto-start of `ollama serve`
                          # that runs when that warm fails with the server down
